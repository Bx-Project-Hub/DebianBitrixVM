<!DOCTYPE html>
<html lang="{{ 'ru' if (menu_lang | default('ru')) == 'ru' else 'en' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ 'Новый сайт' if (menu_lang | default('ru')) == 'ru' else 'New site' }}: {{ domain | e }}</title>
    <style>
        :root {
            --bg-1: #0f172a;
            --bg-2: #1e293b;
            --card: #ffffff;
            --text: #0f172a;
            --muted: #64748b;
            --line: #e2e8f0;
            --accent: #2563eb;
            --accent-hover: #1d4ed8;
            --warn-bg: #fff7ed;
            --warn-line: #fdba74;
            --warn-text: #9a3412;
            --ok: #16a34a;
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --card: #111827;
                --text: #e5e7eb;
                --muted: #94a3b8;
                --line: #1f2937;
                --accent: #3b82f6;
                --accent-hover: #60a5fa;
                --warn-bg: #2b1a0d;
                --warn-line: #9a3412;
                --warn-text: #fdba74;
                --ok: #22c55e;
            }
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 16px;
            font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                  "Helvetica Neue", Arial, "Noto Sans", sans-serif;
            color: var(--text);
            background:
                radial-gradient(900px 500px at 10% -10%, #1d4ed8 0%, transparent 60%),
                radial-gradient(700px 400px at 110% 110%, #0f766e 0%, transparent 55%),
                linear-gradient(160deg, var(--bg-1), var(--bg-2));
        }
        .card {
            width: 100%;
            max-width: 680px;
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 32px;
            box-shadow: 0 24px 60px rgba(2, 6, 23, .45);
        }
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: .02em;
            color: var(--ok);
            background: rgba(22, 163, 74, .12);
        }
        .badge::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--ok);
        }
        h1 {
            margin: 18px 0 6px;
            font-size: 28px;
            line-height: 1.25;
            word-break: break-word;
        }
        .lead { margin: 0 0 24px; color: var(--muted); }
        .steps { list-style: none; margin: 0 0 24px; padding: 0; }
        .steps li {
            display: flex;
            gap: 12px;
            padding: 12px 0;
            border-top: 1px solid var(--line);
        }
        .steps li:first-child { border-top: 0; }
        .steps .num {
            flex: 0 0 26px;
            height: 26px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 13px;
            font-weight: 700;
            color: #fff;
            background: var(--accent);
        }
        .steps b { font-weight: 600; }
        .steps span { color: var(--muted); }
        .actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 8px 0 0; }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 13px 22px;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            color: #fff;
            background: var(--accent);
            transition: background .15s ease, transform .15s ease;
        }
        .btn:hover { background: var(--accent-hover); transform: translateY(-1px); }
        .btn svg { width: 18px; height: 18px; }
        .file {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border: 1px solid var(--line);
            border-radius: 12px;
            font-size: 14px;
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            color: var(--text);
            text-decoration: none;
        }
        .file:hover { border-color: var(--accent); color: var(--accent); }
        .note {
            margin: 24px 0 0;
            padding: 14px 16px;
            border: 1px solid var(--warn-line);
            border-left-width: 4px;
            border-radius: 12px;
            background: var(--warn-bg);
            color: var(--warn-text);
            font-size: 14px;
        }
        .note b { display: block; margin-bottom: 4px; }
        footer {
            margin-top: 24px;
            padding-top: 16px;
            border-top: 1px solid var(--line);
            color: var(--muted);
            font-size: 13px;
        }
    </style>
</head>
<body>
{# restore.php намеренно не выводится: скрипт размещается только по запросу из меню #}
{% set install_files = file_names_download | default([]) | reject('equalto', 'restore.php') | list %}
{% set t = {
     'ru': {
         'badge': 'Сайт создан',
         'lead': 'Что дальше',
         's1': 'Откройте мастер установки',
         's1d': 'Запустится установщик Bitrix: проверка окружения и развёртывание ядра.',
         's2': 'Укажите базу данных',
         's2d': 'Параметры подключения уже записаны в bitrix/php_interface/dbconn.php.',
         's3': 'Завершите установку и войдите в админку',
         's3d': 'Мастер создаст администратора и настроит портал.',
         'btn': 'Открыть мастер установки',
         'warn_title': 'Восстановление из резервной копии',
         'warn': 'Скрипта restore.php в каталоге сайта нет — так и должно быть. Если нужно восстановить портал, разместите его из меню сервера: 8 → 5 → 1. После восстановления сразу удалите: 8 → 5 → 2.',
         'footer': 'Файлы сайта принадлежат www-data. Удалите установщик bitrixsetup.php после завершения установки.'
     },
     'en': {
         'badge': 'Site created',
         'lead': 'What is next',
         's1': 'Open the setup wizard',
         's1d': 'The Bitrix installer starts: environment checks and core deployment.',
         's2': 'Provide the database',
         's2d': 'Connection settings are already written to bitrix/php_interface/dbconn.php.',
         's3': 'Finish the installation and sign in',
         's3d': 'The wizard creates the administrator account and configures the portal.',
         'btn': 'Open the setup wizard',
         'warn_title': 'Restoring from a backup',
         'warn': 'restore.php is intentionally absent from the site directory. If you need to restore a portal, place it from the server menu: 8 → 5 → 1, and delete it right after the restore: 8 → 5 → 2.',
         'footer': 'Site files are owned by www-data. Delete the bitrixsetup.php installer once the installation is complete.'
     }
} %}
{% set m = t['ru'] if (menu_lang | default('ru')) == 'ru' else t['en'] %}
<div class="card">
    <span class="badge">{{ m.badge }}</span>
    <h1>{{ domain | e }}</h1>
    <p class="lead">{{ m.lead }}</p>

    <ol class="steps">
        <li>
            <span class="num">1</span>
            <div><b>{{ m.s1 }}</b><br><span>{{ m.s1d }}</span></div>
        </li>
        <li>
            <span class="num">2</span>
            <div><b>{{ m.s2 }}</b><br><span>{{ m.s2d }}</span></div>
        </li>
        <li>
            <span class="num">3</span>
            <div><b>{{ m.s3 }}</b><br><span>{{ m.s3d }}</span></div>
        </li>
    </ol>

    <div class="actions">
        {% for item in install_files %}
            {% if loop.first %}
            <a class="btn" href="/{{ item | e }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>
                </svg>
                {{ m.btn }}
            </a>
            {% else %}
            <a class="file" href="/{{ item | e }}">{{ item | e }}</a>
            {% endif %}
        {% endfor %}
    </div>

    <p class="note">
        <b>{{ m.warn_title }}</b>
        {{ m.warn }}
    </p>

    <footer>{{ m.footer }}</footer>
</div>
</body>
</html>
